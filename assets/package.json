{
  "name": "@woylie/doggo",
  "version": "0.14.9",
  "description": "JavaScript hooks for the Doggo component library",
  "repository": "https://github.com/woylie/doggo",
  "author": "Mathias Polligkeit",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "lint": "pnpm run lint:prettier && pnpm run lint:eslint",
    "lint:eslint": "eslint .",
    "lint:eslint:fix": "eslint . --fix",
    "lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:eslint:fix",
    "lint:prettier": "prettier . --check",
    "lint:prettier:fix": "prettier . --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "js/index.js",
  "exports": {
    ".": "./js/index.js",
    "./accordion": "./js/hooks/accordion.js",
    "./carousel": "./js/hooks/carousel.js",
    "./tabs": "./js/hooks/tabs.js",
    "./toolbar": "./js/hooks/toolbar.js",
    "./tooltip": "./js/hooks/tooltip.js",
    "./menu": "./js/hooks/menu.js",
    "./menu_button": "./js/hooks/menu_button.js",
    "./tree": "./js/hooks/tree.js",
    "./split_pane": "./js/hooks/split_pane.js"
  },
  "files": [
    "js"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.15",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
