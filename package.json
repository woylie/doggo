{
  "name": "@woylie/doggo",
  "version": "0.14.9",
  "description": "JavaScript hooks for the Doggo component library",
  "keywords": [
    "phoenix",
    "liveview",
    "hooks",
    "components",
    "accessibility"
  ],
  "homepage": "https://hexdocs.pm/doggo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/woylie/doggo.git"
  },
  "bugs": "https://github.com/woylie/doggo/issues",
  "author": "Mathias Polligkeit",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint": "pnpm run lint:prettier && pnpm run lint:eslint",
    "lint:eslint": "eslint assets",
    "lint:eslint:fix": "eslint assets --fix",
    "lint:fix": "pnpm run lint:prettier:fix && pnpm run lint:eslint:fix",
    "lint:prettier": "prettier assets --check",
    "lint:prettier:fix": "prettier assets --write",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "main": "assets/js/index.js",
  "exports": {
    ".": "./assets/js/index.js",
    "./accordion": "./assets/js/hooks/accordion.js",
    "./carousel": "./assets/js/hooks/carousel.js",
    "./combobox": "./assets/js/hooks/combobox.js",
    "./tabs": "./assets/js/hooks/tabs.js",
    "./toolbar": "./assets/js/hooks/toolbar.js",
    "./tooltip": "./assets/js/hooks/tooltip.js",
    "./menu": "./assets/js/hooks/menu.js",
    "./menu_button": "./assets/js/hooks/menu_button.js",
    "./tree": "./assets/js/hooks/tree.js",
    "./dialog": "./assets/js/hooks/dialog.js",
    "./split_pane": "./assets/js/hooks/split_pane.js"
  },
  "files": [
    "assets/js"
  ],
  "sideEffects": false,
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.15",
    "prettier": "^3.9.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "pnpm@11.24.0+sha512.bd27e345e976dcb0be0b7a1228217b049a817e21b1f355c90dbe7dc46671895a8bc1e6d06c24554505ea93ea0b45f489a27ec1bfbc8de6a9659fca0f16fa0000"
}
